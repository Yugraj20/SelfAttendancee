rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one document, keyed by their own uid, holding a mirror
    // of their local subjects/attendance/timetable/settings. Nobody else can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
