{
  "name": "self-attendance",
  "version": "1.0.1",
  "description": "Production-ready, local-first attendance tracker with IndexedDB, Firestore sync, and Gemini AI timetable import",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
