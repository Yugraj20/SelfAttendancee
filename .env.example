# Firebase web configuration (safe to expose as client configuration; restrict it in Firebase console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. A browser key is visible to clients: restrict it by HTTP referrer and Gemini API in Google Cloud.
# Prefer a serverless proxy for production deployments.
VITE_GEMINI_API_KEY=
